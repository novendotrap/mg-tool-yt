# Python cache
__pycache__/
*.py[cod]

# Byte-compiled / optimized / DLL files
*-cpython-*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
venv/
env/
.venv/
.env

# IDE/editor folders
.vscode/
